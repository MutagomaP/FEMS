PORT=3004
NODE_ENV=development
JWT_SECRET=fems-dev-jwt-secret-change-in-production
SERVICE_INTERNAL_KEY=dev-internal-service-key

CUSTOMER_SERVICE_URL=http://localhost:3002
EXTINGUISHER_SERVICE_URL=http://localhost:3003
DATABASE_URL=postgresql://postgres:12345@localhost:5433/fems_notifications

# SMTP (optional — mock mode when SMTP_HOST is unset; OTP shown in UI in dev)
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=noreply@fems.local

CORS_ORIGIN=http://localhost:5173
