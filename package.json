{
  "name": "fems-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@fems/shared",
    "dev:gateway": "npm run start:dev --workspace=@fems/api-gateway",
    "dev:auth": "npm run start:dev --workspace=@fems/auth-service",
    "dev:customer": "npm run start:dev --workspace=@fems/customer-service",
    "dev:extinguisher": "npm run start:dev --workspace=@fems/extinguisher-service",
    "dev:notification": "npm run start:dev --workspace=@fems/notification-service",
    "dev:renewal": "npm run start:dev --workspace=@fems/renewal-service",
    "dev:compliance": "npm run start:dev --workspace=@fems/compliance-service",
    "dev:report": "npm run start:dev --workspace=@fems/report-service",
    "dev:inspection": "npm run start:dev --workspace=@fems/inspection-maintenance-service",
    "stop:services": "node scripts/stop-services.mjs",
    "backup:databases": "node scripts/backup-databases.mjs",
    "export:schema": "node scripts/export-database-schema.mjs",
    "restore:databases": "node scripts/restore-databases.mjs",
    "fix:schemas": "node scripts/fix-schemas.mjs",
    "dev:services": "npm run build:shared && concurrently -n auth,customer,extinguisher,notification,renewal,compliance,report,inspection,gateway -c green,yellow,magenta,cyan,red,white,gray,bgBlue,blue \"npm run dev:auth\" \"npm run dev:customer\" \"npm run dev:extinguisher\" \"npm run dev:notification\" \"npm run dev:renewal\" \"npm run dev:compliance\" \"npm run dev:report\" \"npm run dev:inspection\" \"node scripts/wait-and-gateway.mjs\"",
    "install:all": "npm install",
    "seed": "node scripts/seed.mjs",
    "test:apis": "node scripts/test-apis.mjs",
    "test:perf": "node scripts/perf-smoke.mjs",
    "test:auth": "npm test --workspace=@fems/auth-service"
  },
  "devDependencies": {
    "bcrypt": "^6.0.0",
    "concurrently": "^9.2.0",
    "lodash": "^4.17.21",
    "pg": "^8.21.0"
  }
}
